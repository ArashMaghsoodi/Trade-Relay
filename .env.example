# =========================
# Telegram user session (reads VIP channel)
# =========================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=trade_relay
VIP_CHANNEL_IDS=

# =========================
# Telegram bot (reports + controller)
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# =========================
# Toobit API (futures)
# =========================
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
TOOBIT_BASE_URL=https://api.toobit.com
TOOBIT_FUTURES_BASE_URL=https://api.toobit.com

# =========================
# Trading defaults
# =========================
TRADING_MODE=dry_run
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=15
RISK_PER_TRADE_PERCENT=1
MARGIN_MODE=cross
ONE_POSITION_PER_SYMBOL=true

# =========================
# Runtime
# =========================
LOG_LEVEL=INFO
TIMEZONE=UTC
STATE_DB_PATH=trade_relay.db
