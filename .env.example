# ---------------------------------------------------------------------------
# trade-relay configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- MASTER SAFETY SWITCH ----------------------------------------------------
# While false, the exchange client refuses to place/modify/close any real
# order no matter what the rest of the app decides. Keep this false until
# you've validated parser accuracy via /report over several days.
LIVE_TRADING_ENABLED=false

# --- Telethon (reads the private VIP channel with YOUR Telegram account) ----
# From https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telethon will create this session file on first login (interactive login
# the first time you run main.py). Keep this file as secret as a password.
TELETHON_SESSION_NAME=trade_relay_session
# Numeric ID or @username of the private VIP channel to watch
VIP_CHANNEL_ID=

# --- Control bot (separate bot created via @BotFather, your dashboard) ------
CONTROL_BOT_TOKEN=
# Your own numeric Telegram user ID (the control bot ignores everyone else).
# Get this from @userinfobot if you don't have it handy.
OWNER_TELEGRAM_ID=

# --- TooBit -------------------------------------------------------------
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
TOOBIT_BASE_URL=https://api.toobit.com

# --- AI-assisted parsing (optional, used only for parsing/classification) --
# The rule-based parser runs first; the AI parser is a fallback for messages
# it can't confidently parse. It never makes trading decisions.
AI_PARSER_ENABLED=false
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# --- Position sizing ----------------------------------------------------
DEFAULT_WALLET_PERCENT=5.0
MIN_WALLET_PERCENT=4.0
MAX_WALLET_PERCENT=8.0
DEFAULT_LEVERAGE=10

# --- Risk / safety thresholds --------------------------------------------
# Max age (seconds) a signal may be before it's considered stale
MAX_SIGNAL_AGE_SECONDS=180
# Reject a session if its SL is further from current mark price than this (%)
MAX_SL_DISTANCE_PCT=15.0
# Reject a session if its TP is further from current mark price than this (%)
MAX_TP_DISTANCE_PCT=50.0
# Minimum parser confidence (0-1) required before a session can reach READY
MIN_PARSER_CONFIDENCE=0.75

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./trade_relay.db

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
